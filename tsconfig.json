{
	"extends": "@react-native/typescript-config",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"types": [
			"jest"
		],
		"baseUrl": ".",
		"paths": {
			"@components": [
				"src/components"
			],
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": [
		"**/node_modules",
		"**/Pods"
	]
}